{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "echo \"export const environment = { production: true, emailjs: { serviceId: '$EMAILJS_SERVICE_ID', templateId: '$EMAILJS_TEMPLATE_ID', publicKey: '$EMAILJS_PUBLIC_KEY' } };\" > src/environments/environment.prod.ts && pnpm build",
  "outputDirectory": "dist/portafolio/browser",
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, immutable" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, immutable" }
      ]
    },
    {
      "source": "/assets/models/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/data/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/:path*.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, immutable" }
      ]
    },
    {
      "source": "/:path*.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, immutable" }
      ]
    }
  ]
}
